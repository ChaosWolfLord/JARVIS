# Copy this file to %LOCALAPPDATA%\jarvis\.env (outside OneDrive) and paste your own key after the = sign.
# A .env in the project folder also works, but OneDrive uploads that folder, so keep keys in the local one.
# Free key: https://aistudio.google.com/apikey (sign in with a Google account)
GEMINI_API_KEY=

# Optional overrides
# JARVIS tries models in order and moves to the next when one is rate-limited. Default order:
#   gemini:gemini-3.6-flash, gemini:gemini-3.5-flash-lite, groq:openai/gpt-oss-120b,
#   groq:qwen/qwen3.8-27b, gemini:gemini-3.8-flash   (models whose key is missing are skipped)
# JARVIS_CHAIN=gemini:gemini-3.6-flash,groq:openai/gpt-oss-120b
# JARVIS_MODEL=gemini-3.6-flash # or pin one model: JARVIS_PROVIDER=gemini|groq|openrouter|ollama + this
# JARVIS_EFFORT=low             # low | medium | high thinking, sent to Gemini models only

# Extra free providers (used by the fallback chain once it's built)
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys . With a key here JARVIS asks OpenRouter which free models can call
# tools and tries them first (the Gemini/Groq models above stay as the back-up if their keys are set).
# Free models allow 20 requests a minute and 50 a day; buying $10 of credits once raises that to 1,000 a day.
# Discord (read-only): your own bot's token, see README "Connect Calendar, Gmail and Discord". Then: connect.bat discord
# DISCORD_BOT_TOKEN=

# OPENROUTER_API_KEY=
# OPENROUTER_DAILY_LIMIT=50     # 1000 after buying credits. Only used for the "requests left" warning
# JARVIS_OPENROUTER_FIRST=google/gemma-4-31b-it:free   # models to try first, comma-separated
# JARVIS_CHAIN=openrouter:auto-free                     # OpenRouter only, nothing else
# JARVIS_MAX_STEPS=8            # most model calls (look-ups included) in one reply

# Offline wake word (needs: pip install -r requirements-wake.txt, then python -m server.wakeword --get-model)
# JARVIS_WAKEWORD=1
# JARVIS_WAKEWORD_DEVICE=      # microphone name or number, if the default is wrong (python -m server.wakeword --list-devices)

# System health alerts (red sticky notes, spoken). Defaults shown; JARVIS_ALERTS=0 silences them, JARVIS_DIAGNOSTICS=0 turns the monitor off
# JARVIS_ALERT_DISK_FREE_PCT=10
# JARVIS_ALERT_DISK_FREE_GB=8
# JARVIS_ALERT_MEM_PCT=92
# JARVIS_ALERT_CPU_PCT=95

# Govee smart lights. Local control needs LAN Control switched on in the Govee Home app; otherwise use an API key (app: Settings > About Us > Apply for API Key)
# GOVEE_IPS=192.168.1.40,192.168.1.41   # only if the automatic scan can't find them
# GOVEE_API_KEY=
# JARVIS_LIGHTS=0                       # turn the lights feature off

# Music on your speakers (needs: pip install -r requirements-music.txt)
# MUSIC_DEVICE=Kitchen      # the speaker used when you don't name one
# JARVIS_MUSIC=0            # turn the music feature off

# Personality: 0 polite, 1 dry, 2 sarcastic (default), 3 merciless. JARVIS_CALL_ME is how it may address you (default: no title)
# JARVIS_SNARK=2
# JARVIS_CALL_ME=

# News ticker: your own RSS feeds (default: BBC World, BBC Technology, Hacker News); JARVIS_NEWS=0 turns the ticker's feed off
# JARVIS_NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://hnrss.org/frontpage
# JARVIS_NEWS=0

# Opening and closing apps (JARVIS_APPS=0 turns it off; %LOCALAPPDATA%\jarvis\apps.json can block apps or limit it to a list)
# JARVIS_APPS=0

# Spoken Claude Code alerts (the hook script's settings are in %LOCALAPPDATA%\jarvis\claude_notify.json); JARVIS_CLAUDE_NOTIFY=0 turns them off
# JARVIS_CLAUDE_NOTIFY=0

# Pen tracker started and restarted by JARVIS.bat (the options you'd give run_tracker.bat)
# JARVIS_TRACKER_ARGS=--source cv:NAME --size 1280x800 --fps 100
